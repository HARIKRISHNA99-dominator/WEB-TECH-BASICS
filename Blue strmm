import React, { useState } from 'react';
import { motion } from 'framer-motion';
import { User, CircleDollarSign, Users, ChevronRight } from 'lucide-react';

// --- Types ---
interface StreamData {
  id: number;
  name: string;
  role: string;
  streamTitle: string;
  budget: string;
  headcount: string;
  objectives: string[];
}

// --- Card Component ---
const ValueStreamCard = ({ data }: { data: StreamData }) => {
  const [isHovered, setIsHovered] = useState(false);

  return (
    <div className="flex bg-white border border-gray-300 shadow-sm h-56 w-full overflow-hidden">
      {/* LEFT PANEL: Profile (Static) */}
      <div className="w-[35%] flex flex-col items-center justify-center border-r border-gray-200 bg-gray-50/50 p-4">
        <div className="w-20 h-20 border border-gray-400 flex items-center justify-center mb-3 bg-white">
          <User size={40} className="text-gray-400 stroke-[1px]" />
        </div>
        <h3 className="text-xs font-bold text-gray-800 text-center leading-tight">{data.name}</h3>
        <p className="text-[9px] font-semibold text-gray-500 text-center uppercase mt-1 leading-tight">
          {data.role}
        </p>
        <p className="text-[9px] text-gray-400 mt-1">United Kingdom</p>
      </div>

      {/* RIGHT PANEL: Flipping Container */}
      <div 
        className="w-[65%] relative perspective-1000"
        onMouseEnter={() => setIsHovered(true)}
        onMouseLeave={() => setIsHovered(false)}
      >
        <motion.div
          className="w-full h-full relative preserve-3d"
          animate={{ rotateY: isHovered ? 180 : 0 }}
          transition={{ duration: 0.6, ease: "easeInOut" }}
        >
          {/* FRONT SIDE */}
          <div className="absolute inset-0 backface-hidden bg-white p-5 flex flex-col">
            <h2 className="text-lg font-bold text-gray-800 mb-0.5">{data.streamTitle}</h2>
            <p className="text-[10px] text-gray-400 italic mb-4">Description - Lorem Ipsum...</p>
            
            <div className="flex gap-2 mb-4">
              <div className="flex items-center gap-2 bg-[#e0f2f7] px-2 py-1.5 rounded-sm flex-1">
                <CircleDollarSign size={14} className="text-[#43a0bd]" />
                <span className="text-xs font-bold text-[#333]">{data.budget}</span>
              </div>
              <div className="flex items-center gap-2 bg-[#e0f2f7] px-2 py-1.5 rounded-sm flex-1">
                <Users size={14} className="text-[#43a0bd]" />
                <span className="text-xs font-bold text-[#333]">{data.headcount}</span>
              </div>
            </div>

            <div className="mt-auto flex items-center justify-center text-gray-500 text-[10px] font-bold">
              Hover for details <ChevronRight size={12} className="ml-1" />
            </div>
          </div>

          {/* BACK SIDE (Pink Section) */}
          <div 
            className="absolute inset-0 backface-hidden bg-[#f3d1d6] p-5 flex flex-col overflow-y-auto"
            style={{ transform: 'rotateY(180deg)' }}
          >
            <h4 className="font-bold text-xs text-gray-800 mb-2">Key Objectives</h4>
            <ul className="space-y-1 mb-3">
              {data.objectives.map((obj, i) => (
                <li key={i} className="text-[10px] text-gray-700 leading-tight flex items-start">
                  <span className="mr-1.5">•</span> {obj}
                </li>
              ))}
            </ul>
            <h4 className="font-bold text-xs text-gray-800">Key Achievements</h4>
            <p className="text-[10px] text-gray-600 italic">No achievements listed yet.</p>
          </div>
        </motion.div>
      </div>
    </div>
  );
};

