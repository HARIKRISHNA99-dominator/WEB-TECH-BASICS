"""
Control-M Country Config Generator
====================================
Generates a country-specific Control-M XML file from the LALQ-IE-TMIS template.

USAGE:
  1. Set COUNTRY_CODE below to your target 2-letter country code (e.g. "QA", "DE", "FR")
  2. Run: python generate_ctm_config.py
  3. Output file will be created as:  LALQ-<COUNTRY>-TMIS_<country>.xml

HOW PLACEHOLDERS WORK IN THE TEMPLATE:
  {CC}  → uppercase country code  (e.g. QA)
  {cc}  → lowercase country code  (e.g. qa)
"""

import os
import sys

# ============================================================
#  >>>  CHANGE ONLY THIS VALUE  <<<
COUNTRY_CODE = "QA"   # e.g. "QA", "DE", "FR", "SG", "ZA"
# ============================================================


def generate(country_code: str, template_path: str = None, output_dir: str = None):
    """
    Reads the template XML and substitutes {CC} / {cc} with the
    supplied country code, then writes the result to a new file.

    Parameters
    ----------
    country_code : str
        Two-letter country code (case-insensitive; will be auto-uppercased).
    template_path : str, optional
        Path to the template XML. Defaults to LALQ-IE-TMIS_TEMPLATE.xml
        in the same directory as this script.
    output_dir : str, optional
        Directory where the output file is written. Defaults to the
        same directory as this script.
    """
    cc_upper = country_code.strip().upper()
    cc_lower = cc_upper.lower()

    if len(cc_upper) != 2 or not cc_upper.isalpha():
        print(f"ERROR: '{country_code}' is not a valid 2-letter country code.")
        sys.exit(1)

    script_dir = os.path.dirname(os.path.abspath(__file__))

    if template_path is None:
        template_path = os.path.join(script_dir, "LALQ-IE-TMIS_TEMPLATE.xml")

    if not os.path.isfile(template_path):
        print(f"ERROR: Template file not found: {template_path}")
        sys.exit(1)

    if output_dir is None:
        output_dir = script_dir

    # Read template
    with open(template_path, "r", encoding="utf-8") as fh:
        content = fh.read()

    # Replace placeholders  ({CC} before {cc} to avoid double-lower-casing)
    content = content.replace("{CC}", cc_upper)
    content = content.replace("{cc}", cc_lower)

    # Build output filename
    output_filename = f"LALQ-{cc_upper}-TMIS_{cc_lower}.xml"
    output_path = os.path.join(output_dir, output_filename)

    with open(output_path, "w", encoding="utf-8") as fh:
        fh.write(content)

    print(f"✅  Generated: {output_path}")
    print(f"    Country  : {cc_upper}")
    print(f"    Template : {template_path}")
    return output_path


if __name__ == "__main__":
    if len(sys.argv) == 2:
        COUNTRY_CODE = sys.argv[1]

    generate(COUNTRY_CODE)
